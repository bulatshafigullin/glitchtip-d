# /etc/glitchtip/env  (chmod 640, root:glitchtip)
# Postgres over the local unix socket: the OS user running the service must match the database role (peer auth).
DATABASE_URL=postgres://glitchtip@/glitchtip?host=/var/run/postgresql
PORT=4002
BIND_ADDRESS=127.0.0.1
TRUST_PROXY=true
PUBLIC_URL=https://sentry.example.com
ENABLE_REGISTRATION=false
WORKERS=2
RETENTION_DAYS=90
